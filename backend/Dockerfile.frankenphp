# ---------- Tahap 1: install dependency PHP ----------
# Versi image dasar eksplisit (bukan latest).
FROM composer:2.8.8 AS vendor

WORKDIR /app

# composer.json & composer.lock disalin lebih dulu DAN dependency diinstal
# sebelum kode aplikasi disalin -> cache layer tetap efektif.
COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --prefer-dist

# ---------- Tahap 2: runtime FrankenPHP ----------
# Versi eksplisit: 1 (versi utama FrankenPHP) + php8.3 + bookworm.
FROM dunglas/frankenphp:1-php8.3-bookworm

WORKDIR /app

# Hanya extension yang benar-benar dipakai aplikasi.
# pdo_mysql  -> koneksi ke database MySQL
# opcache    -> cache opcode PHP
# intl       -> formatasi lokal/tanggal
# zip        -> butuh oleh composer/artisan
RUN install-php-extensions pdo_mysql opcache intl zip

# Dependensi aplikasi hasil tahap 1.
# .env tidak pernah ikut karena .dockerignore mengecualikannya.
COPY --from=vendor /app/vendor ./vendor

# Kode aplikasi.
COPY . .

# Konfigurasi FrankenPHP: menyajikan folder public Laravel sebagai aplikasi PHP.
COPY Caddyfile /etc/caddy/Caddyfile
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
    && mkdir -p storage/framework/cache/data storage/framework/sessions \
                storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

ENV APP_ENV=production \
    APP_DEBUG=false \
    DB_CONNECTION=mysql \
    CACHE_STORE=file \
    SESSION_DRIVER=file \
    QUEUE_CONNECTION=sync \
    FRANKENPHP_CONFIG=/etc/caddy/Caddyfile

EXPOSE 8000

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]