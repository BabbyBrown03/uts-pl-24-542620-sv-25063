# Pastikan file shell script & Dockerfile selalu LF agar tidak rusak
# saat disalin ke container Linux (CRLF menyebabkan "not found").
*.sh text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Caddyfile text eol=lf
*.conf text eol=lf

# Teks umum
*.php text eol=lf
*.js text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary: jangan disentuh
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary