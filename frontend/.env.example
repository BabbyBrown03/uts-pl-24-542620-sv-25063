# Base URL API yang dipakai APLIKASI saat runtime.
#
#  - Docker Compose (frontend -> Nginx):  /api
#    Nginx meneruskan /api ke service "backend:8000" di jaringan Docker.
#  - Dev lokal (npm run dev):             /api
#    Vite mem-proxy /api ke backend (lihat vite.config.js).
#  - Build statis dibuka tanpa proxy:     http://localhost:8000
VITE_API_BASE_URL=/api

# Target proxy Vite saat `npm run dev` (hanya dibaca oleh vite.config.js).
VITE_API_DEV_PROXY=http://127.0.0.1:8000

# Email akun admin hasil seeder, hanya untuk ditampilkan di halaman login.
VITE_ADMIN_EMAIL=admin@inventaris.test