# Salin file ini menjadi .env di root repository, lalu sesuaikan nilainya.
#   cp .env.example .env
# File .env TIDAK boleh di-commit ke repository.

# --- Kredensial database (dipakai oleh service mysql & backend) ---
DB_DATABASE=inventaris
DB_USERNAME=inventaris
DB_PASSWORD=ganti_password_database_ini
DB_ROOT_PASSWORD=ganti_password_root_ini
DB_PORT_HOST=3307

# --- Laravel ---
# Wajib diisi. Buat dengan:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_URL=http://localhost:8000

# --- Akun admin hasil seeder ---
ADMIN_EMAIL=admin@inventaris.test

# --- Port yang dipublikasikan ke host ---
FRONTEND_PORT=8080
BACKEND_PORT=8000

# --- CORS: origin frontend yang diizinkan (dipisah koma) ---
FRONTEND_URL=http://localhost:8080,http://localhost:5173

# --- Seeder: false untuk melewati seeding admin ---
RUN_SEEDER=true